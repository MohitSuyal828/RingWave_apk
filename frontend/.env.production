# ============================================================================
# PRODUCTION build config for the Android app (used by `npm run build`
# before `npx cap sync android`).
#
# THESE PLACEHOLDER VALUES WILL NOT WORK ON A REAL DEVICE. "localhost"
# means "this phone itself" to an Android device — there is no backend
# running on the phone, so every API call and every call/detection
# feature would fail immediately if you shipped an APK built with these
# values as-is.
#
# Before building the real APK, replace these three with your ACTUALLY
# DEPLOYED backend + AI service URLs (e.g. from Railway/Render — see
# DEPLOYMENT.md in the repo root, which this project already has configs
# for). They must be https:// / wss:// — plaintext http/ws will not work
# from an Android WebView loaded over https (see capacitor.config.ts's
# androidScheme setting).
# ============================================================================

VITE_API_URL=https://ringwave-production.up.railway.app/api/v1
VITE_SOCKET_URL=https://ringwave-production.up.railway.app
VITE_DETECTION_WS_URL=wss://zooming-rejoicing-production-41c4.up.railway.app/ws/detect

VITE_APP_NAME=RingWave
VITE_APP_VERSION=1.0.0

# ============================
# API / WebSocket endpoints
# ============================
#
# These are BUILD-TIME values — Vite bakes them into the compiled JS. If
# you change one after building, you must rebuild (or, for Docker, pass it
# as a --build-arg — see Dockerfile). Setting these on Vercel's project
# Environment Variables works normally, since Vercel builds the app itself.
#
# In production these must be https:// / wss:// — a page served over HTTPS
# (which both Vercel and any custom domain with SSL will be) cannot make
# http:// or ws:// requests to a different origin; browsers block that as
# mixed content.

VITE_API_URL=http://localhost:5000/api/v1
VITE_SOCKET_URL=http://localhost:5000
VITE_DETECTION_WS_URL=ws://localhost:8000/ws/detect

VITE_APP_NAME=RingWave
VITE_APP_VERSION=1.0.0
